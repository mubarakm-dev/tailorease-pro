generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model Company {
  id            String                @id @default(uuid())
  companyCode   String                @unique
  companyName   String
  email         String                @unique
  passwordHash  String
  companyImage  String?
  status        CompanyStatus         @default(UNVERIFIED)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @default(now()) @updatedAt
  staff         Staff[]
  customers     Customer[]
  templates     MeasurementTemplate[]
  orders        Order[]
  activityLogs  ActivityLog[]
}

model Staff {
  id               String          @id @default(uuid())
  companyId        String
  fullName         String
  email            String         @unique
  phone            String?
  passwordHash     String
  role             Role            @default(STAFF)
  status           StaffStatus     @default(UNVERIFIED)
  createdAt        DateTime        @default(now())
  company          Company         @relation(fields: [companyId], references: [id])
  customersCreated Customer[]
  measurementsCreated Measurement[]
  measurementsUpdated Measurement[] @relation("MeasurementUpdatedBy")
  photosUploaded   OrderPhoto[]
  orders           Order[]
  statusHistory    StatusHistory[]
  activityLogs     ActivityLog[]
  passwordResetToken PasswordResetToken?

  @@index([companyId])
}

model Customer {
  id             String        @id @default(uuid())
  companyId      String
  fullName       String
  email          String?
  phone          String
  createdBy      String
  createdAt      DateTime      @default(now())
  company        Company       @relation(fields: [companyId], references: [id])
  createdByStaff Staff         @relation(fields: [createdBy], references: [id])
  measurements   Measurement[]
  orders         Order[]

  @@index([companyId])
  @@index([createdBy])
}

model MeasurementTemplate {
  id               String        @id @default(uuid())
  companyId        String
  name             String
  fieldDefinitions Json
  createdAt        DateTime      @default(now())
  company          Company       @relation(fields: [companyId], references: [id])
  measurements     Measurement[]

  @@index([companyId])
}

model Measurement {
  id         String              @id @default(uuid())
  customerId String
  templateId String
  unit       String              @default("cm")
  createdBy  String
  updatedBy  String?
  values     Json
  snapshot   Json
  notes      Json?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  customer   Customer            @relation(fields: [customerId], references: [id])
  template   MeasurementTemplate @relation(fields: [templateId], references: [id])
  createdByStaff Staff           @relation(fields: [createdBy], references: [id])
  updatedByStaff Staff?              @relation("MeasurementUpdatedBy", fields: [updatedBy], references: [id])
  orders     Order[]

  @@index([customerId])
  @@index([templateId])
  @@index([createdBy])
  @@index([updatedBy])
}

model Order {
  id              String          @id @default(uuid())
  customerId      String
  companyId       String
  staffId         String
  measurementId   String?
  parentOrderId   String?
  title           String
  amount          Int?
  type            OrderType       @default(NEW)
  status          OrderStatus     @default(RECEIVED)
  paymentStatus   PaymentStatus   @default(UNPAID)
  dueDate         DateTime?
  notes           Json
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt
  customer        Customer        @relation(fields: [customerId], references: [id])
  company         Company         @relation(fields: [companyId], references: [id])
  staff           Staff           @relation(fields: [staffId], references: [id])
  measurement     Measurement?    @relation(fields: [measurementId], references: [id])
  parentOrder     Order?          @relation("OrderAmendments", fields: [parentOrderId], references: [id])
  amendments      Order[]         @relation("OrderAmendments")
  photos          OrderPhoto[]
  payments        Payment[]
  statusHistory   StatusHistory[]

  @@index([customerId])
  @@index([companyId])
  @@index([staffId])
  @@index([measurementId])
  @@index([parentOrderId])
  @@index([dueDate])
  @@index([paymentStatus])
}

model Payment {
  id            String    @id @default(uuid())
  orderId       String
  amount        Int
  paymentMethod String?
  notes         String?
  createdAt     DateTime  @default(now())
  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

model OrderPhoto {
  id         String   @id @default(uuid())
  orderId    String
  uploadedBy String
  url        String
  caption    String?
  uploadedAt DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id])
  uploadedByStaff Staff @relation(fields: [uploadedBy], references: [id])

  @@index([orderId])
  @@index([uploadedBy])
}

model StatusHistory {
  id          String      @id @default(uuid())
  orderId     String
  updatedById String
  status      OrderStatus
  note        String?
  createdAt   DateTime    @default(now())
  order       Order       @relation(fields: [orderId], references: [id])
  updatedBy   Staff       @relation(fields: [updatedById], references: [id])

  @@index([orderId])
  @@index([updatedById])
}

model VerificationCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model ActivityLog {
  id         String   @id @default(uuid())
  companyId  String
  staffId    String?              
  action     String              
  entityType String?              
  entityId   String?              
  summary    String               
  createdAt  DateTime @default(now())

  company    Company  @relation(fields: [companyId], references: [id])
  staff      Staff?   @relation(fields: [staffId], references: [id])

  @@index([companyId, createdAt])
  @@index([staffId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  staffId   String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
}

enum CompanyStatus {
  UNVERIFIED
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

enum Role {
  SUPER_ADMIN
  STAFF
}

enum StaffStatus {
  UNVERIFIED
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum OrderType {
  NEW
  AMENDMENT
}

enum OrderStatus {
  RECEIVED
  CUT_IN_PROGRESS
  SEWING_IN_PROGRESS
  FINISHING
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}